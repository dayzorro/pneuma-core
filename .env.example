# ─────────────────────────────────────────────────────────────
# Pneuma Core 后端对话服务 —— 环境变量示例
# 复制为 .env 后填入真实值：cp .env.example .env
# 注意：.env 已在 .gitignore 中，不会被提交
# ─────────────────────────────────────────────────────────────

# ===== LLM（OpenAI 兼容端点，必填）=====
# 任何提供 /v1/chat/completions 的服务都可以，例如：
#   阿里云百炼  https://dashscope.aliyuncs.com/compatible-mode/v1
#   DeepSeek    https://api.deepseek.com/v1
#   OpenRouter  https://openrouter.ai/api/v1
PNEUMA_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
PNEUMA_LLM_API_KEY=your-llm-api-key
PNEUMA_LLM_MODEL=qwen-plus
PNEUMA_LLM_TIMEOUT=60

# 思考（thinking）开关的 extra_body 键名。
# 思考型模型（如 qwen3 系列）默认会生成大量隐藏推理 token，显著拖慢响应。
# 设置该键后，每轮对话与情绪评估会自动关闭思考（快 ~3-5 倍），
# 仅在「会话结束的记忆整合」保留思考以保证质量。
#   阿里云百炼 / DashScope：enable_thinking
#   不填 = 完全不干预（换到不认识该参数的供应商时保持安全）
PNEUMA_LLM_THINKING_PARAM=enable_thinking

# ===== Embedding（OpenAI 兼容端点）=====
# 若不填，则复用上面的 LLM base_url / API key（适用于同一家供应商）
# 阿里云百炼向量模型：text-embedding-v3 / text-embedding-v4
PNEUMA_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
PNEUMA_EMBEDDING_API_KEY=your-embedding-api-key
PNEUMA_EMBEDDING_MODEL=text-embedding-v3

# ===== 服务 =====
PNEUMA_HOST=0.0.0.0
PNEUMA_PORT=8001

# ===== 角色与存储 =====
# 角色卡 YAML 路径（examples/ 下有 aine.character.yaml / rin.character.yaml）
PNEUMA_CHARACTER_FILE=examples/aine.character.yaml
# SQLite 数据库路径（会话状态 / 记忆 / 关系持久化）
PNEUMA_DB_PATH=vault/pneuma.db

# 可选：用户上下文目录（不存在则跳过该功能）
# PNEUMA_USER_CONTEXT_DIR=vault/user

# ===== 行为调优（可选）=====
# 历史消息上限，超过后由 LLM 摘要压缩
PNEUMA_HISTORY_LIMIT=30
# true = 每轮同步评估情感（更准但更慢、每轮多一次 LLM 调用）
# false = 后台异步评估，返回的 emotion 为「本轮开始时」的状态
PNEUMA_DIAGNOSTIC=false
