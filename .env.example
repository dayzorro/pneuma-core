# ─────────────────────────────────────────────────────────────
# Pneuma Core 后端对话服务 —— 环境变量示例
# 复制为 .env 后填入真实值：cp .env.example .env
# 注意：.env 已在 .gitignore 中，不会被提交
# ─────────────────────────────────────────────────────────────

# ===== LLM（OpenAI 兼容端点，必填）=====
# 任何提供 /v1/chat/completions 的服务都可以，例如：
#   阿里云百炼  https://dashscope.aliyuncs.com/compatible-mode/v1
#   DeepSeek    https://api.deepseek.com/v1
#   OpenRouter  https://openrouter.ai/api/v1
PNEUMA_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
PNEUMA_LLM_API_KEY=your-llm-api-key
PNEUMA_LLM_MODEL=qwen-plus
PNEUMA_LLM_TIMEOUT=60

# 思考（thinking）开关的 extra_body 键名。
# 思考型模型（如 qwen3 系列）默认会生成大量隐藏推理 token，显著拖慢响应。
# 设置该键后，每轮对话与情绪评估会自动关闭思考（快 ~3-5 倍），
# 仅在「会话结束的记忆整合」保留思考以保证质量。
#   阿里云百炼 / DashScope：enable_thinking
#   不填 = 完全不干预（换到不认识该参数的供应商时保持安全）
PNEUMA_LLM_THINKING_PARAM=enable_thinking

# ===== Embedding（OpenAI 兼容端点）=====
# 若不填，则复用上面的 LLM base_url / API key（适用于同一家供应商）
# 阿里云百炼向量模型：text-embedding-v3 / text-embedding-v4
PNEUMA_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
PNEUMA_EMBEDDING_API_KEY=your-embedding-api-key
PNEUMA_EMBEDDING_MODEL=text-embedding-v3

# ===== 服务 =====
PNEUMA_HOST=0.0.0.0
PNEUMA_PORT=8001
# 日志级别：info（默认）/ debug。设为 debug 可在日志里看到每轮的时延埋点明细
# （形如 `turn latency (ms): {'embedding': 132.4, 'llm_first_token': 486.1, ...}`），
# 代价是第三方库（httpx/openai）的 DEBUG 日志也会一并输出，比较吵。
PNEUMA_LOG_LEVEL=info

# ===== 角色与存储 =====
# 角色卡 YAML 路径（examples/ 下有 xiaorun-frontdesk.character.yaml / aine.character.yaml）
# 默认角色是华润万家门店前台「小润」
PNEUMA_CHARACTER_FILE=examples/xiaorun-frontdesk.character.yaml
# SQLite 数据库路径（会话状态 / 记忆 / 关系持久化）
PNEUMA_DB_PATH=vault/pneuma.db

# 可选：用户上下文目录（不存在则跳过该功能）
# PNEUMA_USER_CONTEXT_DIR=vault/user

# ===== 本地知识库（专业知识问答）=====
# Markdown 语料目录（默认取包内置的华润万家语料）
# PNEUMA_KNOWLEDGE_DIR=src/pneuma_core/knowledge/data/huarun
# 向量索引路径。存在则用向量检索（更准）；不存在则退化为关键词检索。
# 构建方式： .venv/bin/python scripts/build_knowledge_index.py
PNEUMA_KNOWLEDGE_INDEX=vault/knowledge_index.json
# 每轮注入提示词的知识块条数
PNEUMA_KNOWLEDGE_TOP_K=3

# ===== 行为调优（可选）=====
# 历史消息上限，超过后由 LLM 摘要压缩
PNEUMA_HISTORY_LIMIT=30
# true = 每轮同步评估情感（更准但更慢、每轮多一次 LLM 调用）
# false = 后台异步评估，返回的 emotion 为「本轮开始时」的状态
PNEUMA_DIAGNOSTIC=false

# ===== 联网检索：博查 AI Search（可选）=====
# 申请 Key：https://open.bochaai.com/  →  填入下面这一项即可启用
# 留空 = 关闭联网检索，同时也会关闭「认知提炼」（该功能依赖联网结果）
PNEUMA_BOCHA_API_KEY=
# 接口地址与端点。AI Search 需在博查侧开通权限；若返回 401「无接口调用权限」，
# 把 PNEUMA_BOCHA_ENDPOINT 换成 /v1/web-search 即可（基础全网搜索，无需额外权限）
PNEUMA_BOCHA_BASE_URL=https://api.bocha.cn
PNEUMA_BOCHA_ENDPOINT=/v1/ai-search
# 每次返回的结果条数（1〜50）
PNEUMA_BOCHA_COUNT=8
# 时间范围：noLimit | oneDay | oneWeek | oneMonth | oneYear | YYYY-MM-DD..YYYY-MM-DD
PNEUMA_BOCHA_FRESHNESS=noLimit
PNEUMA_BOCHA_TIMEOUT=20
# 是否额外让博查返回一份它自己生成的大模型总结（计入其侧调用）。
# false（默认）= 只取原始网页摘要，由角色自己综合；true = 多一份现成总结，回答更直接
PNEUMA_BOCHA_ANSWER=false

# 联网时机：
#   auto   = 本地知识库没命中，且问题指向外部实时信息（今天/最新/新闻/活动…）时才联网（默认）
#   always = 每轮都联网（演示用）
#   off    = 完全不联网
PNEUMA_WEB_SEARCH_MODE=auto

# 联网检索的总开关（服务级）。false（默认）= 无条件不联网，交互关键路径上
# 完全不触发外网调用，首字时延不受影响。
# 该开关可在网页右上角的「联网检索」开关上实时切换，无需重启服务。
PNEUMA_WEB_SEARCH_ENABLED=false

# ===== 认知库（联网信息提炼出的行业通识认知块）=====
# 认知库文件：联网结果经 LLM 提炼成「商超前台行业通识」后存放在这里，
# 与人工整理的资料库分开，检索时会一起被检索到
PNEUMA_INSIGHT_STORE=vault/insights.json
# 单轮最多提炼多少条认知块
PNEUMA_INSIGHT_MAX_PER_TURN=5
